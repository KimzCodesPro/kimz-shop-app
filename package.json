{
  "name": "kimz-shop-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~58.0.26",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@native-html/render": "^1.0.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.20",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-otp-entry": "^1.8.6",
    "react-native-reanimated": "4.7.1",
    "react-native-reanimated-carousel": "^5.1.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-size-matters": "^0.4.2",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.0",
    "redux-devtools-expo-dev-plugin": "^0.2.1",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "prebuild:clean": "rm -rf ios android && expo prebuild --clean",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "web": "expo start --web",
    "lint": "npx expo lint --max-warnings=0",
    "type-check": "npx tsc --noEmit",
    "prepare": "husky"
  },
  "private": true,
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "redux-devtools-expo-dev-plugin"
        ]
      }
    }
  }
}

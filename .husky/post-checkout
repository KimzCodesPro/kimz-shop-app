prev=$1
new=$2
flag=$3

# Only act on branch checkouts (not file checkouts)
[ "$flag" = "1" ] || exit 0

# Only act when prev == new (typical for a freshly created branch)
[ "$prev" = "$new" ] || exit 0

branch=$(git symbolic-ref --short -q HEAD) || exit 0

# Skip if already prefixed, contains a slash, or is main
case "$branch" in
  [0-9][0-9]-*|*/*|main|master) exit 0 ;;
esac

# Confirm this is a brand-new branch (reflog has exactly one entry)
reflog_count=$(git reflog show "$branch" 2>/dev/null | wc -l | tr -d ' ')
[ "$reflog_count" = "1" ] || exit 0

# Find next NN- prefix across all local + remote branches
last=$(git branch -a --format='%(refname:short)' \
  | sed 's|^origin/||' \
  | grep -oE '^[0-9]{2}' \
  | sort -u | tail -1)
next=$(printf "%02d" $((10#${last:--1} + 1)))

new_name="${next}-${branch}"
git branch -m "$branch" "$new_name"
echo "Renamed branch: $branch → $new_name"

# Create a notes file for this branch in .project-steps/
notes_dir=".project-steps"
notes_file="$notes_dir/${new_name}.md"
if [ ! -f "$notes_file" ]; then
  mkdir -p "$notes_dir"
  {
    echo "# ${new_name}"
    echo ""
    echo "## What I did"
    echo "- "
    echo ""
    echo "## Why"
    echo "- "
    echo ""
    echo "## Key files"
    echo "- "
    echo ""
    echo "## Recording notes"
    echo "- "
  } > "$notes_file"
  echo "Created notes: $notes_file"
fi
